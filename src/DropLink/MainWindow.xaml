<Window x:Class="DropLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLink" Icon="Assets/DropLink.ico" SourceInitialized="Window_SourceInitialized" Width="1180" Height="760" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111811" BorderBrush="#263428" BorderThickness="1" CornerRadius="18" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="2,4,0,28">
                        <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource GreenBrush}" VerticalAlignment="Center">
                            <TextBlock Text="D" FontSize="28" FontWeight="Bold" Foreground="#182411" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DropLink" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="BrandTagline" Text="SHARE DIRECTLY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" Foreground="#81927F" FontSize="10" FontWeight="Bold" Margin="5,0,0,10" />
                    <Button x:Name="SharesNav" Style="{StaticResource NavButton}" Click="SharesNav_Click" Margin="0,0,0,4" />
                    <Button x:Name="TransfersNav" Style="{StaticResource NavButton}" Click="TransfersNav_Click" Margin="0,0,0,4" />
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click" Margin="0,0,0,4" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#172118" BorderBrush="#29392B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#E0B35C" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServerStatusText" Text="Avvio server…" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ServerAddressText" Text="Porta 43821" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TopTitle" Text="Condivisioni" FontSize="26" FontWeight="Bold" />
                    <TextBlock x:Name="TopSubtitle" Text="Il tuo spazio di condivisione" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="18" Background="#1A271A" BorderBrush="#334632" BorderThickness="1" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="TopStatusDot" Width="7" Height="7" Fill="#E0B35C" VerticalAlignment="Center" />
                        <TextBlock x:Name="TopStatusText" Text="HTTP locale" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <ContentControl x:Name="PageHost" Grid.Row="1" />
            <Border x:Name="ToastBorder" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,12,0" Padding="14,10" CornerRadius="12" BorderThickness="1"
                    Background="#18291B" BorderBrush="#3B5B3A" Visibility="Collapsed"
                    IsHitTestVisible="False" Panel.ZIndex="100" MaxWidth="500">
                <StackPanel Orientation="Horizontal" MaxWidth="470">
                    <TextBlock x:Name="ToastGlyph" Text="✓" Foreground="#B5F17A" FontSize="18"
                               FontWeight="Bold" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastMessage" Text="" Foreground="#F0F6ED" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="430" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
